Build-Depends: debhelper-compat (= 13)
Standards-Version: 4.6.2
Rules-Requires-Root: no

Package: froggle-ca
Architecture: all
Depends: ca-certificates, ${misc:Depends}
Description: FROGGLE internal CA certificates
 Installs the FROGGLE root and infrastructure CA certificates into the
 system trust store: /usr/share/ca-certificates/froggle/, enabled in
 /etc/ca-certificates.conf.
