#!/bin/sh
set -e

if [ "$1" = "purge" ]; then
    # Our keyfile is gone; dconf update would still compile an empty
    # local.d into a db and never deletes a db whose dir is gone.
    rmdir /etc/dconf/db/local.d 2>/dev/null || true
    if [ ! -d /etc/dconf/db/local.d ]; then
        rm -f /etc/dconf/db/local
    fi
fi

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v dconf >/dev/null 2>&1; then
        dconf update
    fi
fi

#DEBHELPER#
