#!/usr/bin/make -f
PKG = debian/froggle-qubes-keepassxc-wrapper
HOST = org.keepassxc.keepassxc_browser.json

%:
	dh $@

# Firefox reads /usr/lib/mozilla; Chromium (and Brave) /etc/chromium; Google
# Chrome /etc/opt/chrome.
execute_after_dh_install:
	install -D -m 0644 manifests/firefox.json $(PKG)/usr/lib/mozilla/native-messaging-hosts/$(HOST)
	install -D -m 0644 manifests/chromium.json $(PKG)/etc/chromium/native-messaging-hosts/$(HOST)
	install -D -m 0644 manifests/chromium.json $(PKG)/etc/opt/chrome/native-messaging-hosts/$(HOST)
